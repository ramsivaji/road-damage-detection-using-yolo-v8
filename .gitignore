.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.streamlit/secrets.toml

# Runtime data and generated model artifacts.
dataset/downloads/*
dataset/raw/*
dataset/raw/images/*
dataset/annotations/*
dataset/images/*
dataset/labels/*
models/*.pt
models/versions/*
outputs/*

# Keep the required runtime directories in source control.
!.gitkeep
!dataset/downloads/.gitkeep
!dataset/raw/.gitkeep
!dataset/raw/annotations/.gitkeep
!dataset/raw/images/.gitkeep
!dataset/annotations/.gitkeep
!dataset/images/train/.gitkeep
!dataset/images/val/.gitkeep
!dataset/images/test/.gitkeep
!dataset/labels/train/.gitkeep
!dataset/labels/val/.gitkeep
!dataset/labels/test/.gitkeep
!models/versions/.gitkeep
!outputs/images/.gitkeep
!outputs/detections/.gitkeep
!outputs/videos/.gitkeep
!outputs/training/.gitkeep
!outputs/evaluation/.gitkeep
